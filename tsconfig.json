{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"noEmit": true,
		"strict": true,
		"noImplicitAny": false,
		"target": "ES2015",
		"module": "ESNext",
		"lib": ["DOM", "ES5"]
	},
	"include": [
		"public/core/**/*.js",
		"public/components/**/*.js",
		"public/pages/**/*.js",
		"scripts/shared-types.d.ts"
	]
}
